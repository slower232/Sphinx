# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" al repositorio.
SPHINX_ENV=development            # development | production
SECRET_KEY=                       # obligatoria en producción: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_PATH=instance/sphinx.db
TRUST_PROXY=0                     # 1 si está detrás de un proxy inverso (Render, Fly, Nginx...)
ANON_RETENTION_DAYS=30            # días que se conserva el progreso de invitados inactivos
PUBLIC_BASE_URL=http://127.0.0.1:5000   # se usa en enlaces de correo y verificación de certificados

# Correo (opcional; necesario para recuperar contraseñas)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sphinx@example.org

# Tutor de IA (opcional). Sin ANTHROPIC_API_KEY el tutor se muestra como no disponible.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-5-5
TUTOR_DAILY_LIMIT=20              # mensajes por estudiante al día
TUTOR_MINUTE_LIMIT=4              # mensajes por estudiante por minuto
